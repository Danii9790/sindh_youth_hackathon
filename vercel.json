{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",

  "regions": ["iad1"],  

  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },

  "functions": {
    "app/**/*.{js,ts,jsx,tsx}": {
      "maxDuration": 60  
    },
    "pages/api/**/*.{js,ts}": {
      "maxDuration": 60
    }
  },

  "env": {
    "NEXT_PUBLIC_APP_URL": "https://www.doctoragent.systems",
    "OPENAI_API_KEY": "@openai_api_key"
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
