# ===== REQUIRED: DATABASE CONFIGURATION =====
NEON_POSTGRES_URL=postgresql://your-neon-db-url-here

# ===== REQUIRED: CLERK AUTHENTICATION =====
# Get these from: https://dashboard.clerk.com → [Your App] → API Keys
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===== REQUIRED: APPLICATION CONFIGURATION =====
ADMIN_USERS=your_clerk_user_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# ===== OPTIONAL: MONITORING & ANALYTICS =====
# Sentry for error monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id